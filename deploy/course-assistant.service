[Unit]
Description=课程助手（课程资料 → 逐日复习计划）
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/course-assistant

# 访问口令：公网上必须改成 12 位以上随机串，别用默认值
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(12))"
Environment=ACCESS_CODE=CHANGE_ME_BEFORE_PUBLIC
# 同时跑几个分析。2核2G 建议 2，再多会互相拖慢
Environment=MAX_JOBS=2
Environment=PYTHONUNBUFFERED=1

# 只监听本机，由 Caddy 反代并终止 TLS。
# 如果暂时没有域名、想用 IP:端口 直连，把下面改成 --host 0.0.0.0
ExecStart=/opt/course-assistant/.venv/bin/python -m uvicorn app:app \
    --host 127.0.0.1 --port 8000 --proxy-headers

Restart=always
RestartSec=3

# 加固：进程只对自己的目录有写权限，/tmp 与 /home 不可见
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/course-assistant/data

[Install]
WantedBy=multi-user.target
